# ---------------------------------------------------------------------------
# JanSaathi backend configuration. Copy to backend/.env and edit.
# ---------------------------------------------------------------------------

# local = built-in retrieval-only answers (no keys needed, works today)
# azure = Azure AI Foundry model deployment
AI_PROVIDER=local

# ---- Azure AI Foundry (only used when AI_PROVIDER=azure) --------------------
# Endpoint of your Foundry / Azure OpenAI resource. Any of these forms works:
#   https://<resource>.openai.azure.com/
#   https://<resource>.services.ai.azure.com/
AZURE_OPENAI_ENDPOINT=
# Your DEPLOYMENT name from Foundry (Models + endpoints), not the base model name.
AZURE_OPENAI_DEPLOYMENT=
# Option A: API key.  Option B: leave blank to use Microsoft Entra ID
# (az login locally, managed identity when deployed).
AZURE_OPENAI_API_KEY=
# Only for Entra ID auth. If it fails in your tenant try:
#   https://cognitiveservices.azure.com/.default
AZURE_AI_TOKEN_SCOPE=https://ai.azure.com/.default

# ---- Generation -------------------------------------------------------------
MODEL_MAX_TOKENS=700
# Leave BLANK for reasoning models (o-series / gpt-5): they reject temperature.
MODEL_TEMPERATURE=0.2
REQUEST_TIMEOUT_SECONDS=30

# ---- Protection ---------------------------------------------------------------
MAX_HISTORY_MESSAGES=10
RATE_LIMIT_PER_MINUTE=30
# true when running behind Azure App Service / Container Apps / Front Door
TRUST_PROXY=false

# ---- Web -----------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Built React app served by FastAPI in production (Dockerfile fills this in)
STATIC_DIR=static
LOG_LEVEL=INFO
